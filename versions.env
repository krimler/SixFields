# Every version this repo depends on. Nothing floats. `make doctor` verifies the
# installed tools against these values; CI pins from this file only.
# Sources for each pick are in docs/api-snapshot.md and DECISIONS.md.

# --- toolchain ---
GO_VERSION=1.25.4
# sigs.k8s.io/cluster-api/api@v1.14.2 declares `go 1.26.0`; the hack/tools module
# that reads it lets the Go toolchain fetch that. The main module builds on GO_VERSION.
GO_TOOLCHAIN=go1.26.0
GOLANGCI_LINT_VERSION=v2.13.2
GOTESTSUM_VERSION=v1.14.0
KUBECONFORM_VERSION=v0.7.0
SETUP_ENVTEST_VERSION=release-0.23

# --- cluster api ---
# Contract v1beta2 (metadata.yaml, releaseSeries 1.14). v1beta1 contract is still
# accepted but is scheduled for removal; see docs/api-snapshot.md "Contract check".
CAPI_VERSION=v1.14.2
CAPI_CONTRACT=v1beta2
CAPD_VERSION=v1.14.2
CLUSTERCTL_VERSION=v1.14.2
K0SMOTRON_VERSION=v1.10.9
# The k0s release must carry the same Kubernetes version the assembly installs
# everywhere else: a hosted control plane on one minor and a topology version on
# another leaves workers unable to fetch their worker-config ConfigMap.
# TestAssembly_K0sMatchesTheWorkloadKubernetesVersion holds them together.
K0S_VERSION=v1.34.11+k0s.0
# The same k0s release, spelled two ways, because k0smotron wants two spellings:
# K0smotronControlPlane puts it in an image tag, where + is not valid, and
# K0sWorkerConfig rejects the dash form outright ("k0s specific versions must be
# specified using the '+k0s' suffix", validate-k0sworkerconfig-v1beta1.k0smotron.io).
# Keep the two in step; TestAssembly_K0sVersionsAreTheSameRelease holds them there.
K0SMOTRON_K0S_VERSION=v1.34.11-k0s.0

# --- kubernetes ---
KIND_VERSION=v0.33.0
KUBECTL_VERSION=v1.34.1
# Management cluster. VAP is GA from 1.30; this is well past it.
MGMT_K8S_VERSION=v1.34.11
MGMT_NODE_IMAGE=kindest/node:v1.34.11@sha256:44e222ee2132dab25ff87301682f89eb82c7880ea3a1bf543bfe9708fd08d67d
# Workload clusters created by the assembly (CAPD boots the same image).
WORKLOAD_K8S_VERSION=v1.34.11
WORKLOAD_NODE_IMAGE=kindest/node:v1.34.11@sha256:44e222ee2132dab25ff87301682f89eb82c7880ea3a1bf543bfe9708fd08d67d
ENVTEST_K8S_VERSION=1.34.1

# --- addons ---
# A workload cluster's nodes stay NotReady until a CNI is installed, so the
# assembly ships one: that is the opinion, and it is what makes the fourth phase
# report something. Pinned by digest, not by tag; hack/addons.sh verifies it.
CNI_NAME=calico
CNI_VERSION=v3.32.2
CNI_MANIFEST_URL=https://raw.githubusercontent.com/projectcalico/calico/v3.32.2/manifests/calico.yaml
CNI_SHA256=a8c828a06a87c629a282ebbc424895b77f3a030251993e41ea400a743675bb02

# --- local model (see docs/ai.md, D4.1) ---
# `make doctor-ai` recommends a model from free memory and writes its pick here.
# Unset until a run of `make doctor-ai` on the target machine fills it in.
CLUSTER_AI_MODEL=
CLUSTER_AI_QUANT=
CLUSTER_AI_SHA256=
CLUSTER_AI_RUNTIME=
CLUSTER_AI_URL=http://127.0.0.1:1234/v1

# --- caps ---
# Hard stop for paid API use; the must-ask list in CLAUDE.md starts here.
AI_DAILY_TOKEN_CAP=200000
AI_CREDIT_CAP_USD=0

# --- time budgets (hack/timebox.sh asserts these) ---
TEST_BUDGET_S=30
TEST_ENVTEST_BUDGET_S=180
E2E_BUDGET_S=1500

# --- go module pins (kept on the management cluster's minor) ---
K8S_LIBS_VERSION=v0.34.1
CONTROLLER_RUNTIME_VERSION=v0.22.4
CEL_GO_VERSION=v0.26.0
